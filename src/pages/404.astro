---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found – Muhammed Shamil">
  <div class="wrap nf">
    <h1>This page is not on the timeline.</h1>
    <p>The link may be old or mistyped. <a href="/">Go to the homepage</a> to see all my work.</p>
  </div>
</Base>
<style>
  .nf { padding-block: clamp(4rem, 12vw, 9rem); }
  h1 { font-size: clamp(2.25rem, 6vw, 4.5rem); font-weight: 800; font-variation-settings: 'wdth' 125; letter-spacing: -0.02em; max-width: 18ch; margin-bottom: 1.25rem; }
  p { font-size: var(--s1); }
</style>
